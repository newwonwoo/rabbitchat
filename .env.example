# Provider mode. "mock" (default) keeps the app fully offline.
# Switch to "real" ONLY after the four real-API keys below are present.
# When real and a key is missing, the provider throws on first call.
NEXT_PUBLIC_PROVIDER=mock

# LLM vendor for AI story authoring. "openai" (default) or "grok".
# Both use OpenAI-compatible chat-completions endpoints.
LLM_VENDOR=openai

# OpenAI — STT (Whisper) + LLM chat completions.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Grok (xAI) — alternative LLM. Drop-in replacement for OpenAI.
# https://console.x.ai/
GROK_API_KEY=

# ElevenLabs — used by TTS for the cloned 엄마 voice.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Pexels — used by /api/image-search to auto-fetch license-safe images
# when a local PNG is missing. Free, immediate, no card required.
# https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Supabase (P2 — turn log persistence). Stub-wired only.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
