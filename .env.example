# Provider mode. "mock" (default) keeps the app fully offline.
# Set to "real" only after wiring an actual STT/LLM/TTS adapter
# in lib/providers/index.ts — until then "real" will throw at startup.
NEXT_PUBLIC_PROVIDER=mock

# Reserved — used by future adapters.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
